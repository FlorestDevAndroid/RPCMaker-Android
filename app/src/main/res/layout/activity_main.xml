<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="#1E1F22"
              android:fitsSystemWindows="true">

    <!-- Заголовок приложения: всегда сверху, не перекрывает контент -->
    <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2B2D31"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="RPCMaker"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:elevation="4dp" />

    <!-- Область контента: WebView + форма накладываются друг на друга -->
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- WebView для логина в Discord -->
        <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <!-- Форма настройки RPC -->
        <ScrollView
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true"
                android:background="#1E1F22"
                android:clipToPadding="false"
                android:paddingBottom="12dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Name (название приложения)"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Details (первая строка)"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="State (вторая строка)"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Type"
                        android:textColor="#AAAAAA"
                        android:layout_marginBottom="4dp" />

                <Spinner
                        android:id="@+id/spinnerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etLargeImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Large Image Key"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etLargeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Large Image Text"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etSmallImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Small Image Key"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <EditText
                        android:id="@+id/etSmallText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Small Image Text"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Button 1"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp" />

                <EditText
                        android:id="@+id/etBtn1Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Label"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="6dp" />

                <EditText
                        android:id="@+id/etBtn1Url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="URL (https://...)"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="textUri"
                        android:layout_marginBottom="10dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Button 2"
                        android:textColor="#AAAAAA"
                        android:layout_marginBottom="4dp" />

                <EditText
                        android:id="@+id/etBtn2Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Label"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:layout_marginBottom="6dp" />

                <EditText
                        android:id="@+id/etBtn2Url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="URL (https://...)"
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:inputType="textUri"
                        android:layout_marginBottom="8dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Кнопка START/STOP: всегда видна снизу, не уезжает при скролле -->
    <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="START"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#5865F2"
            android:textColor="#FFFFFF" />

</LinearLayout>